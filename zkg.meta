[package]
script_dir = mercury
build_command = ./configure && cmake --build build
test_command = cd testing && btest -c btest.cfg
summary = Mercury fingerprints for Zeek
description = This Zeek plugin implements the Network Fingerprinting (NPF) format as specified in the Mercury project.
depends =
	zeek >=4.0.0

[template]
source = https://github.com/zeek/package-template
version = v3.1.7
zkg_version = 3.0.1-43
features = github-ci,license

[template_vars]
name = Mercury
author = Johanna Amann <johanna@corelight.com>
license = bsd-3
